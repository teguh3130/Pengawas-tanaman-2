# ============================================================
# Sistem Pengawas Tanaman — Backend Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN pernah commit file .env ke git
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# CORS — URL frontend yang diizinkan mengakses backend
CORS_ORIGIN=http://localhost:5173

# Firebase
# Path ke file Service Account JSON yang diunduh dari Firebase Console
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://pengawas-tanaman-4f599-default-rtdb.firebaseio.com

# Gemini AI
# Dapatkan dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model Gemini yang digunakan
GEMINI_MODEL=gemini-1.5-flash

# ESP32 Device Authentication
# Token rahasia yang sama harus dikonfigurasi di esp32/config.py
# Buat token acak yang kuat, minimal 32 karakter
ESP32_DEVICE_TOKEN=your_secret_esp32_device_token_here_min_32_chars

# Sensor — batas fisik hardware (bukan threshold tanaman)
# Nilai ini digunakan untuk menolak data yang jelas tidak valid
SENSOR_TEMP_MIN=-40
SENSOR_TEMP_MAX=80
SENSOR_HUMIDITY_MIN=0
SENSOR_HUMIDITY_MAX=100
SENSOR_SOIL_RAW_MIN=0
SENSOR_SOIL_RAW_MAX=4095
SENSOR_LUX_MIN=0
SENSOR_LUX_MAX=65535

# Riwayat sensor — jumlah maksimum record yang disimpan
# 2016 ≈ 7 hari × 24 jam × 12 record/jam (interval 5 menit)
MAX_HISTORY_RECORDS=2016

# Pompa — pengaman default (dapat di-override dari Firebase)
PUMP_MAX_ON_DURATION_SEC=120
PUMP_DEFAULT_COOLDOWN_SEC=600

# Device offline threshold — detik tanpa kiriman data sebelum dianggap offline
DEVICE_OFFLINE_THRESHOLD_SEC=300

