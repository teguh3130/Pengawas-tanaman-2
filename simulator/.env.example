# ============================================================
# Simulator Environment Variables (.env)
# ============================================================
# Catatan: Simulator akan secara otomatis membaca backend/.env jika ada.
# File ini bersifat opsional untuk meng-override konfigurasi khusus simulator.

BACKEND_URL=http://localhost:3001
ESP32_DEVICE_TOKEN=default_secret_esp32_device_token_key_32chars
SIMULATOR_INTERVAL_SEC=5.0
SIMULATOR_MODE=dynamic

